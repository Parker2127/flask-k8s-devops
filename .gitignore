# ==============================================================================
# Terraform Core Directories and Files
# ==============================================================================
# Local execution directories
.terraform/
**/.terraform/*

# Provider lock file (EXCLUDED from ignore so it is tracked in Git)
!.terraform.lock.hcl

# State files (Contains sensitive infrastructure data and secrets)
*.tfstate
*.tfstate.*
terraform.tfstate
terraform.tfstate.backup

# Execution plans
*.tfplan

# ==============================================================================
# Developer Overrides and Logs
# ==============================================================================
# Local overrides
*.tfx
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Crash and debug logs
crash.log
crash.*.log
debug_az_create.txt

# ==============================================================================
# Sensitive Files and Credentials
# ==============================================================================
access_token.json
account_list.json
provider_storage.json